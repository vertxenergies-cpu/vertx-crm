# ========================================================
# KERALA SOLAR CRM — FIREBASE ENVIRONMENT CONFIGURATION
# ========================================================

# --------------------------------------------------------
# 1. CLIENT FIREBASE SDK (Exposed to browser via NEXT_PUBLIC_)
# --------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyExampleApiKey123456789
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=kerala-solar-crm.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=kerala-solar-crm
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=kerala-solar-crm.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Firebase Local Emulator Support (true when running npm run firebase:emulators)
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# Development-only Mock Fallback (NEVER active in production)
NEXT_PUBLIC_USE_MOCK_DATA=false

# --------------------------------------------------------
# 2. SERVER FIREBASE ADMIN SDK (Strictly confidential, never exposed to browser)
# --------------------------------------------------------
FIREBASE_PROJECT_ID=kerala-solar-crm
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@kerala-solar-crm.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
